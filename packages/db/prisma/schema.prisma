generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum TenantRole {
  ORG_ADMIN
  HR
  TECH_LEAD
  APPLICANT
}

enum PlatformRole {
  SUPER_ADMIN
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum MissionDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum MissionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  NEEDS_REVISION
  ACCEPTED
  REPEAT
}

enum MissionAssignmentStatus {
  ACTIVE
  SUBMITTED
  PASSED
  REPEAT
}

enum FileStatus {
  PENDING
  READY
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  TASK_DUE
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  primaryColor   String   @default("#2563eb")
  secondaryColor String   @default("#0f172a")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logoFileId String?     @unique
  logoFile   StoredFile? @relation("TenantLogo", fields: [logoFileId], references: [id], onDelete: SetNull)

  memberships         TenantMembership[]
  programs            Program[]
  applications        Application[]
  auditLogs           AuditLog[]
  missions            Mission[]
  portfolioItems      PortfolioArtifact[]
  certificates        Certificate[]
  knowledgeDocs       KnowledgeBaseDocument[]
  aiInteractions      AIInteraction[]
  storedFiles         StoredFile[]
  programTasks        ProgramTask[]
  videoResources      VideoResource[]
  notifications       Notification[]
  calendarEvents      CalendarEvent[]
  submissions         Submission[]
  journalEntries      EngineeringJournalEntry[]
  missionAssignments  MissionAssignment[]
  mentorConversations MentorConversation[]

  @@map("tenants")
}

model User {
  id                       String        @id @default(cuid())
  email                    String        @unique
  name                     String?
  // Optional since Keycloak owns credentials as of v0.3.0; local password is legacy.
  passwordHash             String?
  keycloakSubjectId        String?       @unique
  emailVerified            DateTime?
  platformRole             PlatformRole?
  status                   UserStatus    @default(ACTIVE)
  totpSecretEncrypted      String?
  totpEnabledAt            DateTime?
  lastLoginAt              DateTime?
  preferredJournalLanguage String        @default("English")
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  memberships         TenantMembership[]
  applications        Application[]             @relation("ApplicantApplications")
  auditLogs           AuditLog[]
  submissions         Submission[]              @relation("SubmissionApplicant")
  reviewedSubmissions Submission[]              @relation("SubmissionReviewer")
  journalEntries      EngineeringJournalEntry[] @relation("JournalEntryApplicant")
  missionAssignments  MissionAssignment[]       @relation("MissionAssignmentApplicant")
  aiInteractions      AIInteraction[]
  storedFiles         StoredFile[]
  notifications       Notification[]
  taskCompletions     UserTaskCompletion[]
  mentorConversations MentorConversation[]
  graduateProfile     GraduateProfile?

  @@map("users")
}

model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, role])
  @@index([tenantId, role])
  @@index([userId])
  @@map("tenant_memberships")
}

model Program {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String
  status      ProgramStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications       Application[]
  missions           Mission[]
  tasks              ProgramTask[]
  videoResources     VideoResource[]
  calendarEvents     CalendarEvent[]
  journalEntries     EngineeringJournalEntry[]
  missionAssignments MissionAssignment[]
  graduateProfiles   GraduateProfile[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("programs")
}

model Application {
  id            String            @id @default(cuid())
  tenantId      String
  programId     String
  applicantId   String
  status        ApplicationStatus @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewerNotes String?
  githubUrl     String?
  linkedinUrl   String?
  cvFileId      String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program   Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  applicant User                @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  cvFile    StoredFile?         @relation("ApplicationCv", fields: [cvFileId], references: [id], onDelete: SetNull)
  answers   ApplicationAnswer[]

  @@index([tenantId, status])
  @@index([programId, status])
  @@index([applicantId])
  @@map("applications")
}

model ApplicationAnswer {
  id            String   @id @default(cuid())
  applicationId String
  questionKey   String
  questionLabel String
  answer        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionKey])
  @@map("application_answers")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Mission {
  id                 String            @id @default(cuid())
  tenantId           String
  programId          String
  title              String
  difficulty         MissionDifficulty
  status             MissionStatus     @default(DRAFT)
  weekNumber         Int               @default(1)
  order              Int               @default(0)
  brief              String
  objective          String            @default("")
  acceptanceCriteria String            @default("")
  deliverables       String            @default("")
  evaluationCriteria String            @default("")
  competencyTags     String[]          @default([])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program        Program                   @relation(fields: [programId], references: [id], onDelete: Cascade)
  submissions    Submission[]
  journalEntries EngineeringJournalEntry[]
  assignments    MissionAssignment[]

  @@index([tenantId, programId, status])
  @@index([tenantId, status])
  @@map("missions")
}

model MissionAssignment {
  id            String                  @id @default(cuid())
  tenantId      String
  programId     String
  applicantId   String
  missionId     String
  weekNumber    Int
  attemptNumber Int                     @default(1)
  status        MissionAssignmentStatus @default(ACTIVE)
  assignedAt    DateTime                @default(now())
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program        Program                   @relation(fields: [programId], references: [id], onDelete: Cascade)
  applicant      User                      @relation("MissionAssignmentApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  mission        Mission                   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  submissions    Submission[]
  journalEntries EngineeringJournalEntry[]

  @@unique([tenantId, programId, applicantId, weekNumber, attemptNumber], map: "mission_assignment_attempt_key")
  @@index([tenantId, programId, weekNumber])
  @@index([applicantId])
  @@index([missionId])
  @@map("mission_assignments")
}

model Submission {
  id                  String           @id @default(cuid())
  // Direct tenant scoping (v0.15.0, D-067), consistent with every other tenant-owned table.
  tenantId            String
  missionId           String
  applicantId         String
  missionAssignmentId String?          @unique(map: "submission_assignment_key")
  status              SubmissionStatus @default(DRAFT)
  repositoryUrl       String?
  deploymentUrl       String?
  loomUrl             String?
  journalMarkdown     String?
  // Reviewer-assigned score used by the graduate portal (1.0-5.0 when accepted).
  rating              Float?
  submittedAt         DateTime?
  reviewerFeedback    String?
  reviewedAt          DateTime?
  reviewerUserId      String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mission           Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  applicant         User               @relation("SubmissionApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer          User?              @relation("SubmissionReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  missionAssignment MissionAssignment? @relation(fields: [missionAssignmentId], references: [id], onDelete: SetNull)

  // One submission row per assignment attempt; the SEM revision loop reuses that attempt's row.
  @@index([missionId, status])
  @@index([applicantId])
  @@index([tenantId, status])
  @@map("submissions")
}

model EngineeringJournalEntry {
  id                        String    @id @default(cuid())
  tenantId                  String
  applicantId               String
  programId                 String
  missionId                 String
  missionAssignmentId       String?
  weekNumber                Int
  entryDate                 DateTime
  language                  String
  workedOn                  String
  challenge                 String
  solution                  String
  learned                   String
  aiUsage                   String
  confidenceRating          Int
  timeSpentHours            Float
  evidenceLinks             String[]  @default([])
  reflectionDepthScore      Int?
  problemSolvingScore       Int?
  learningQualityScore      Int?
  communicationClarityScore Int?
  consistencyScore          Int?
  totalScore                Int?
  aiReviewFeedback          String?
  aiReviewedAt              DateTime?
  aiReviewMetadata          Json?
  lockedAt                  DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicant         User               @relation("JournalEntryApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  mission           Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionAssignment MissionAssignment? @relation(fields: [missionAssignmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, applicantId, entryDate])
  @@index([tenantId, programId, weekNumber])
  @@index([missionId])
  @@index([missionAssignmentId, entryDate])
  @@map("engineering_journal_entries")
}

model PortfolioArtifact {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("portfolio_artifacts")
}

model Certificate {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  issuedTo  String
  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("certificates")
}

model KnowledgeBaseDocument {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("knowledge_base_documents")
}

model AIInteraction {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  purpose     String
  promptHash  String?
  responseRef String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_interactions")
}

model StoredFile {
  id           String     @id @default(cuid())
  tenantId     String
  ownerUserId  String?
  bucket       String
  storageKey   String     @unique
  originalName String
  contentType  String
  size         Int
  category     String
  status       FileStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner            User?        @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  cvForApplication Application? @relation("ApplicationCv")
  logoForTenant    Tenant?      @relation("TenantLogo")
  graduatePhotoFor GraduateProfile? @relation("GraduateProfilePhoto")

  @@index([tenantId, category])
  @@index([ownerUserId])
  @@map("stored_files")
}

model RegressionDataMarker {
  id         String   @id @default(cuid())
  runId      String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([runId])
  @@index([entityType, entityId])
  @@map("regression_data_markers")
}

/// A task/assignment scoped to a program and a specific week (1-4).
model ProgramTask {
  id          String    @id @default(cuid())
  tenantId    String
  programId   String
  weekNumber  Int
  title       String
  description String?
  dueAt       DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program     Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  completions UserTaskCompletion[]

  @@index([tenantId, programId, weekNumber])
  @@map("program_tasks")
}

/// A video resource (external URL — YouTube/Loom) scoped to a program and optionally a week.
model VideoResource {
  id          String   @id @default(cuid())
  tenantId    String
  programId   String
  weekNumber  Int?
  title       String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([tenantId, programId, weekNumber])
  @@map("video_resources")
}

/// An in-app notification for a specific user.
model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType @default(INFO)
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

/// A scheduled calendar event for a program.
model CalendarEvent {
  id          String    @id @default(cuid())
  tenantId    String
  programId   String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([tenantId, programId, startsAt])
  @@map("calendar_events")
}

/// Join table tracking which applicant has completed a ProgramTask.
model UserTaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  completedAt DateTime @default(now())

  task ProgramTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("user_task_completions")
}

/// A persistent AI mentor conversation scoped to a tenant and user.
model MentorConversation {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  MentorMessage[]

  @@index([tenantId, userId, updatedAt])
  @@map("mentor_conversations")
}

/// A single message within a mentor conversation.
model MentorMessage {
  id              String   @id @default(cuid())
  conversationId  String
  role            String   // "user" | "mentor"
  content         String
  cardsJson       String?  // JSON-serialised MentorCard[]
  createdAt       DateTime @default(now())

  conversation    MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("mentor_messages")
}

// ─────────────────────────────────────────────────────────────────
// PUBLIC GRADUATE DIRECTORY MODELS
// ─────────────────────────────────────────────────────────────────

/// Graduate Profile - Published profiles visible on public portal
model GraduateProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  programId               String?
  profilePhotoFileId      String?  @unique

  // Publication status & consent
  publicProfileEnabled    Boolean  @default(false)
  consentDate             DateTime?
  consentVersion          Int      @default(1)

  // Profile information
  bio                     String?  @db.VarChar(500)
  linkedinUrl             String?  @db.VarChar(500)
  githubUrl               String?  @db.VarChar(500)
  profilePhotoUrl         String?  @db.VarChar(500)
  country                 String?  @db.VarChar(100)
  skills                  String[] @default([])
  interests               String[] @default([])
  emailPublic             Boolean  @default(false)

  // Computed fields
  graduationDate          DateTime
  overallRating           Float
  slug                    String   @unique

  // Generated evaluation summary (null until AI evaluation succeeds)
  aiTechnicalSkills       Float?
  aiProblemSolving        Float?
  aiCommunication         Float?
  aiOwnership             Float?
  aiTeamCollaboration     Float?
  aiSummary               String?  @db.Text
  aiEvaluatedAt           DateTime?

  // Metadata
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program                 Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  profilePhotoFile        StoredFile? @relation("GraduateProfilePhoto", fields: [profilePhotoFileId], references: [id], onDelete: SetNull)
  accessRequests          RecruiterAccessRequest[]
  viewAudits              ProfileViewAudit[]
  artifacts               GraduateArtifact[]
  savedBy                 SavedCandidate[]

  @@index([publicProfileEnabled])
  @@index([overallRating])
  @@index([graduationDate])
  @@index([programId])
  @@map("graduate_profiles")
}

/// Recruiter Access Request - Form submission to view full portfolio
model RecruiterAccessRequest {
  id                      String   @id @default(cuid())
  graduateId              String
  recruiterId             String?

  // Recruiter information
  recruiterName           String
  recruiterOrganization   String?
  recruiterDesignation    String?
  recruiterEmail          String
  recruiterPhone          String?
  hiringRequirement       String?

  // Verification token
  token                   String   @unique
  expiresAt               DateTime
  approvedAt              DateTime?
  consumedAt              DateTime?

  // Timestamps
  createdAt               DateTime @default(now())

  graduate                GraduateProfile @relation(fields: [graduateId], references: [id], onDelete: Cascade)
  recruiter               RecruiterAccount? @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  viewAudits              ProfileViewAudit[]

  @@index([graduateId])
  @@index([token])
  @@index([recruiterEmail])
  @@index([recruiterId])
  @@map("recruiter_access_requests")
}

/// Profile View Audit - Track who viewed which profile
model ProfileViewAudit {
  id                      String   @id @default(cuid())
  graduateId              String
  accessRequestId         String?

  // Recruiter information (captured at view time)
  recruiterEmail          String?
  recruiterName           String?
  recruiterOrganization   String?

  // View information
  viewedAt                DateTime @default(now())
  ipAddress               String?
  userAgent               String?  @db.Text

  graduate                GraduateProfile @relation(fields: [graduateId], references: [id], onDelete: Cascade)
  accessRequest           RecruiterAccessRequest? @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)

  @@index([graduateId])
  @@index([viewedAt])
  @@index([recruiterOrganization])
  @@map("profile_view_audits")
}

model GraduateArtifact {
  id          String   @id @default(cuid())
  graduateId  String
  title       String
  url         String   @db.VarChar(1000)
  description String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  graduate GraduateProfile @relation(fields: [graduateId], references: [id], onDelete: Cascade)

  @@index([graduateId])
  @@map("graduate_artifacts")
}

model RecruiterAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  organization String
  designation  String
  phone        String?
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessRequests RecruiterAccessRequest[]
  sessions       RecruiterSession[]
  savedCandidates SavedCandidate[]

  @@map("recruiter_accounts")
}

model RecruiterSession {
  id          String   @id @default(cuid())
  recruiterId String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  recruiter RecruiterAccount @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
  @@index([expiresAt])
  @@map("recruiter_sessions")
}

model SavedCandidate {
  id          String   @id @default(cuid())
  recruiterId String
  graduateId  String
  createdAt   DateTime @default(now())

  recruiter RecruiterAccount @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  graduate  GraduateProfile  @relation(fields: [graduateId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, graduateId])
  @@index([graduateId])
  @@map("saved_candidates")
}
